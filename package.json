{
  "name": "siyuan-plugin-citation",
  "version": "0.0.3",
  "description": "This is a citation plugin (https://github.com/WingDr/siyuan-plugin-citation) for Siyuan (https://b3log.org/siyuan)",
  "main": ".src/index.js",
  "scripts": {
    "lint": "eslint . --fix --cache",
    "test": "pnpm run test:attr-view && pnpm run test:literature-doc-query && pnpm run test:word-import",
    "test:attr-view": "ts-node --transpile-only --project tsconfig.test.json tests/attrViewConfig.test.ts",
    "test:literature-doc-query": "ts-node --transpile-only --project tsconfig.test.json tests/literatureDocQuery.test.ts",
    "dev": "webpack --mode development",
    "build": "webpack --mode production",
    "test:word-import": "ts-node --transpile-only --project tsconfig.test.json tests/wordImport.test.ts"
  },
  "keywords": [],
  "author": "WingDr",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/svelte": "5.0.4",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "@xmldom/xmldom": "^0.9.12",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "esbuild-loader": "^3.2.0",
    "eslint": "^9.16.0",
    "mini-css-extract-plugin": "2.3.0",
    "sass": "^1.82.0",
    "sass-loader": "^12.6.0",
    "siyuan": "^1.1.8",
    "svelte": "^5.6.2",
    "svelte-loader": "3.2.4",
    "svelte-preprocess": "6.0.3",
    "ts-node": "^10.9.2",
    "tslib": "2.4.0",
    "typescript": "^5.7.2",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4",
    "zip-webpack-plugin": "^4.0.2",
    "zotero-types": "^4.1.2"
  },
  "dependencies": {
    "@retorquere/bibtex-parser": "^9.0.29",
    "axios": "^1.13.6",
    "fflate": "^0.8.3",
    "fuse.js": "^7.1.0",
    "moment": "^2.30.1",
    "template_js": "^3.1.4"
  }
}
